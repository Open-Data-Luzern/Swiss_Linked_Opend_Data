# Vorlage. Kopieren nach .env und ausfuellen. .env nie in Git, nie weitergeben.

# Minimind: Gemma ueber LiteLLM (Fragen im Portal)
SIM_AI_KEY=

# Minimind: Einbettung auf spark5 (hinter Cloudflare Access des KI-Servers)
SPARK5_CLIENT_ID=
SPARK5_CLIENT_SECRET=

# Gemeinsamer Login des Portals. Beide leer = Portal offen (nur lokal!)
PORTAL_BENUTZER=
PORTAL_PASSWORT=

# Begrenzung der KI-Anfragen je Adresse und Stunde
KI_ANFRAGEN_PRO_STUNDE=60

# Nur fuer docker compose: Domain fuer Caddy, Projektwurzel, und unter welcher
# Kennung der Werkzeug-Container in portal/daten schreibt (= Eigentuemer der
# Dateien auf dem Server; ermitteln mit: echo "$(id -u):$(id -g)")
DOMAIN=linkeddata.sim-research.ch
PROJEKT=/srv/swiss_ogd
UID_GID=1000:1000
